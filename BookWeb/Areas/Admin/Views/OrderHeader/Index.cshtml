@model List<Order>

<div class="card shadow border-0 my-4">
    <div class="card-header bg-secondary bg-gradient m-lg-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">Order Header List</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <div class="row pb-3">
            <div class="col-6">
            </div>
            <div class="col-6 text-end">
                <a asp-controller="Order" asp-action="Upsert" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i>Create New Order
                </a>
            </div>
        </div>  
        <table id="tblData" class="table table-bordered table-striped">
            <thead>
                <tr>
                    <td>id</td>
                    <td>UserId</td>
                    <td>orderDate</td>
                    <td>shippingDate</td>
                    <td>orderTotal</td>
                    <td>orderStatus</td>
                    <td>paymentStatus</td>
                    <td>trackingNumber</td>
                    <td>carrier</td>
                    <td>paymentDate</td>
                    <td>paymentDueDate</td>
                    <td>paymentIntentId</td>
                    <td>phoneNumber</td>
                    <td>name</td>
                    <td>streetAddress</td>
                    <td>city</td>
                    <td>state</td>
                    <td>postalCode</td>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts
{
    <script src="~/js/Order.js"></script>
}