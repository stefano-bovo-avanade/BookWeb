@{
    var status = Context.Request.Query["Status"];
    var inprocess = "text-primary";
    var pending = "text-primary";
    var completed = "text-primary";
    var approved = "text-primary";
    var all = "text-primary";

    switch(status)
    {
        case "inprocess":
            inprocess = "active text-white bg-primary";
            break;
        case "pending":
            pending = "active text-white bg-primary";
            break;
        case "completed":
            completed = "active text-white bg-primary";
            break;
        case "approved":
            approved = "active text-white bg-primary";
            break;
        case "all":
            all = "active text-white bg-primary";
            break;
    }
}

<div class="card shadow border-0 my-4">
    <div class="card-header bg-secondary bg-gradient m-lg-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">Order List</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <div class="d-flex justify-content-between pb-5 pt-2">
            <span></span>
            <div class="btn-group" role="group">
                <button type="button" class="btn btn-outline-secondary rounded-0 filter-btn" 
                style="border-color: #ddd;" data-status="inprocess">In corso</button>
                <button type="button" class="btn btn-outline-secondary rounded-0 filter-btn" 
                style="border-color: #ddd;" data-status="pending">In attesa di pagamento</button>
                <button type="button" class="btn btn-outline-secondary rounded-0 filter-btn" 
                style="border-color: #ddd;" data-status="completed">Completati</button>
                <button type="button" class="btn btn-outline-secondary rounded-0 filter-btn" 
                style="border-color: #ddd;" data-status="approved">Approvati</button>
                <button type="button" class="btn btn-outline-secondary rounded-0 filter-btn" 
                style="border-color: #ddd;" data-status="all">Tutti</button>
            </div>
        </div>
        <table id="tblData" class="table table-bordered table-striped" style="width:100%">
            <thead>
                <tr>
                    <th>id</th>
                    <th>name</th>
                    <th>phoneNumber</th>
                    <th>email</th>
                    <th>orderStatus</th>
                    <th>orderTotal</th>
                    <th>id</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts
{
    <script src="~/js/Order.js"></script>
}